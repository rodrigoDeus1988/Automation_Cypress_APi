{
  "name": "cypress-rest",
  "version": "1.0.0",
  "description": "Framework de automação Cypress com rest-api",
  "scripts": {
    "test": "npm run cypress:run",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:allureRun": "npx cypress run --config video=false --env allure=true",
    "cypress:gererate": "npm run cypress:allureGenerate",
    "cypress:allureOpen": "allure open allure-report",
    "test:api": "cypress run --e2e --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:smoke": "cypress run --e2e --spec \"cypress/e2e/web/smoke/**/*.cy.js\"",
    "test:bdd": "cypress run --e2e --spec \"cypress/e2e/bdd/**/*.feature\"",
    "cypress:allureGenerate": "allure generate allure-results --clean"
  },
  "keywords": [],
  "author": "Rodrigo Florindo de Deus",
  "license": "ISC",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "23.2.1",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.4",
    "@shelex/cypress-allure-plugin": "^2.8.3",
    "allure-commandline": "^2.13.8",
    "cypress": "15.2.0",
    "esbuild": "0.25.10",
    "path-browserify": "1.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/bdd/step_definitions/**/*.js"
    ]
  }
}
